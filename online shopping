<!DOCTYPE html>
<html>
<head>
<title>Shopping Website</title>

<style>

body{
    margin:0;
    font-family:Arial,sans-serif;
    background:#f8f4ef;
}

header{
    background:linear-gradient(90deg,#1F3A5F,#4A6FA5,#C9A227);
    color:white;
    text-align:center;
    padding:20px;
}

nav{
    background:#2C4A73;
    padding:15px;
    text-align:center;
}

nav a{
    color:white;
    text-decoration:none;
    margin:20px;
    font-size:18px;
}

.container{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:25px;
    padding:30px;
}

.card{
    background:white;
    border:2px solid #C9A227;
    border-radius:12px;
    padding:15px;
    text-align:center;

    /* Card Shadow */
    box-shadow:0px 8px 18px rgba(31,58,95,0.3);

    transition:0.3s;
}

.card:hover{
    transform:translateY(-8px);
    box-shadow:0px 12px 25px rgba(0,0,0,0.4);
}

.card img{
    width:180px;
    height:180px;
    border-radius:10px;
    box-shadow:0px 5px 12px rgba(0,0,0,0.3);
}

.price{
    background:#C9A227;
    color:white;
    display:inline-block;
    padding:8px 18px;
    border-radius:8px;
    margin-top:10px;
    box-shadow:0px 4px 10px rgba(0,0,0,0.4);
}

button{
    background:#1F3A5F;
    color:white;
    border:none;
    padding:10px 18px;
    margin-top:15px;
    border-radius:8px;
    cursor:pointer;
    box-shadow:0px 5px 12px rgba(0,0,0,0.3);
}

button:hover{
    background:#C9A227;
    color:black;
}

footer{
    background:#1F3A5F;
    color:white;
    text-align:center;
    padding:15px;
}

</style>

</head>

<body>

<header>
<h1>My Shopping Store</h1>
</header>

